# OKX region. EEA accounts use https://eea.okx.com; change only if your account region requires it.
OKX_BASE_URL=https://eea.okx.com
OKX_ENV=live

# Private credentials are NEVER committed. Put them only in the local .env or secret store.
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=

# Safety: all order submission is locked by default.
OKX_TRADING_ENABLED=false

# Candidate USDC spot symbols.
OKX_SYMBOLS=SOL-USDC,XRP-USDC,ETH-USDC,BTC-USDC
OKX_BAR=15m
OKX_CANDLES=200

# Paper-trading parameters.
PAPER_STARTING_USDC=21.88
PAPER_MAX_POSITION_PCT=0.70
PAPER_FEE_RATE=0.001
PAPER_SLIPPAGE_BPS=5
